#!/usr/bin/env python3
"""Build the Default-dark-active xfwm4 theme from the stock Default-xhdpi theme.

  ~/.themes/Default-dark-active/build [WIDTH]     (default 4, at most 12)

Only xfwm4/themerc (the color overrides) and this script are tracked in the
dotfiles repo; every other file in xfwm4/ is generated: copied from
/usr/share/themes/Default-xhdpi/xfwm4 (part of the xfwm4 package), with the
side and bottom border pieces narrowed from 12px to WIDTH by removing the inner
part of the border band, keeping the outer edge and the corners' rounding.
Needs Pillow (for the .png pieces; the .xpm ones are edited as text).
"""
import shutil, sys
from pathlib import Path
from PIL import Image

STOCK = Path('/usr/share/themes/Default-xhdpi/xfwm4')
OUT = Path(__file__).resolve().parent / 'xfwm4'
B = 12  # stock border width

# piece -> [(axis, start, end)]: pixel ranges to remove, axis 0 = columns,
# 1 = rows; negative start/end count from the far edge (like Python slices)
def cuts(w):
    d = B - w
    return {
        'left':         [(0, w, B)],
        'right':        [(0, 0, d)],
        'bottom':       [(1, 0, d)],
        'bottom-left':  [(0, w, B), (1, -B, -w)],
        'bottom-right': [(0, -B, -w), (1, -B, -w)],
    }

def keep(n, start, end):
    """Indices 0..n-1 minus the range start..end (slice semantics)."""
    drop = set(range(n)[start:end if end else None])
    return [i for i in range(n) if i not in drop]

def cut_png(src, dst, ranges):
    im = Image.open(src)
    for axis, start, end in ranges:
        n = im.size[axis]
        idx = keep(n, start, end)
        size = (len(idx), im.size[1]) if axis == 0 else (im.size[0], len(idx))
        new = Image.new(im.mode, size)
        if im.mode == 'P':
            new.putpalette(im.getpalette())
        for j, i in enumerate(idx):
            box = (i, 0, i + 1, im.size[1]) if axis == 0 else (0, i, im.size[0], i + 1)
            new.paste(im.crop(box), (j, 0) if axis == 0 else (0, j))
        new.info = im.info
        im = new
    im.save(dst, **({'transparency': im.info['transparency']} if 'transparency' in im.info else {}))

def cut_xpm(src, dst, ranges):
    lines = src.read_text().split('\n')
    q = [i for i, l in enumerate(lines) if l.startswith('"')]
    w, h, ncolors, cpp = map(int, lines[q[0]].split('"')[1].split()[:4])
    rows = [lines[i].split('"')[1] for i in q[1 + ncolors:1 + ncolors + h]]
    px = [[r[k:k + cpp] for k in range(0, len(r), cpp)] for r in rows]
    for axis, start, end in ranges:
        if axis == 0:
            idx = keep(len(px[0]), start, end)
            px = [[r[i] for i in idx] for r in px]
        else:
            px = [px[i] for i in keep(len(px), start, end)]
    header = lines[q[0]].split('"')[1].split()
    header[:2] = [str(len(px[0])), str(len(px))]
    pix_lines = ['"%s"%s' % (''.join(r), ',' if k < len(px) - 1 else '};') for k, r in enumerate(px)]
    out = lines[:q[0]] + ['"%s",' % ' '.join(header)] + lines[q[0] + 1:q[1 + ncolors]] \
        + pix_lines + lines[q[1 + ncolors + h - 1] + 1:]
    dst.write_text('\n'.join(out))

def main():
    width = int(sys.argv[1]) if len(sys.argv) > 1 else 4
    if not 1 <= width <= B:
        sys.exit(f'width must be 1..{B}')
    OUT.mkdir(exist_ok=True)
    for f in STOCK.iterdir():
        if f.name != 'themerc':  # ours is tracked, with the color overrides
            shutil.copy(f, OUT / f.name)
    if width < B:
        for piece, ranges in cuts(width).items():
            for state in ('active', 'inactive'):
                name = f'{piece}-{state}'
                cut_png(STOCK / f'{name}.png', OUT / f'{name}.png', ranges)
                cut_xpm(STOCK / f'{name}.xpm', OUT / f'{name}.xpm', ranges)
    print(f'built {OUT} with {width}px borders; reload with: xfwm4 --replace &')

main()
