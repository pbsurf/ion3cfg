#!/bin/sh
# Memory usage for xfce4-genmon-plugin: percent in the panel, details in the tooltip.
# "Used" = MemTotal - MemAvailable (page cache doesn't count), same as free(1).
exec awk '
/^MemTotal:/     { t = $2 }
/^MemAvailable:/ { a = $2 }
/^SwapTotal:/    { st = $2 }
/^SwapFree:/     { sf = $2 }
END {
	u = t - a
	printf "<txt> %d%% </txt>\n", u * 100 / t
	print "<txtclick>/home/mwhite/.local/bin/htop-raise mem</txtclick>"
	printf "<tool>Memory: %.1f / %.1f GiB used\nSwap: %.1f / %.1f GiB used</tool>\n", \
		u / 1048576, t / 1048576, (st - sf) / 1048576, st / 1048576
}' /proc/meminfo
